#!/bin/bash
set -euo pipefail
trap 'exit 0' EXIT

# shellcheck source=claude-tg.sh
. "$(dirname "$0")"/claude-tg.sh

json=$(cat)
IFS=$'\t' read -r session turn index cwd agent \
  < <(jq -r '[.session_id, .turn_id, (.index | tostring), .cwd, (.agent_id // "-")] | @tsv' <<< "$json")
[ "$agent" = - ] || exit 0

# One draft spans the whole turn; the assistant messages inside it are separate blocks.
state=$stream_dir/$session
mkdir -p "$state"
if [ "$(cat "$state/turn" 2>/dev/null || :)" != "$turn" ]; then
  tg_title "$cwd" "$session" > "$state/title"
  rm -f "$state/done"
  : > "$state/text"
  printf '%s' "$turn" > "$state/turn"
elif [ "$index" = 0 ]; then
  printf '\n\n' >> "$state/text"
fi
jq -rj .delta <<< "$json" >> "$state/text"

# The terminal holds this text back until the hook returns, so posting happens elsewhere.
pid=$(cat "$state/sender.pid" 2>/dev/null || :)
if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
  setsid "$(dirname "$0")"/claude-stream-send "$state" < /dev/null > /dev/null 2>> "$state/err" &
fi

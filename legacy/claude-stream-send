#!/bin/bash
set -euo pipefail

# shellcheck source=claude-tg.sh
. "$(dirname "$0")"/claude-tg.sh

# Telegram keeps a draft for 30 seconds after the last frame, so a turn that stops
# producing text (a long tool call) still needs frames to keep the draft on screen.
refresh=20
poll=0.5
abandon=300

state=$1
exec 9> "$state/lock"
flock -n 9 || exit 0
echo $$ > "$state/sender.pid"

title=$(cat "$state/title")
# Frames sharing a draft_id animate into each other, so it stays fixed for the turn.
draft=$(($(cksum < "$state/turn" | cut -d ' ' -f 1) + 1))
sent=''
last=0
changed=$(date +%s)

while [ ! -e "$state/done" ]; do
  text=$(cat "$state/text")
  now=$(date +%s)
  if [ "$text" != "$sent" ]; then
    changed=$now
  elif [ $((now - changed)) -ge $abandon ]; then
    break
  fi
  if [ "$text" != "$sent" ] || [ $((now - last)) -ge $refresh ]; then
    body=$title$'\n\n'$text$'\n''<tg-thinking>Generating…</tg-thinking>'
    jq -n --arg c "$CHAT_ID" --argjson d "$draft" --arg b "$body" \
      '{chat_id: ($c | tonumber), draft_id: $d, rich_message: {markdown: $b}}' |
      tg_post sendRichMessageDraft
    sent=$text
    last=$now
  fi
  sleep $poll
done
